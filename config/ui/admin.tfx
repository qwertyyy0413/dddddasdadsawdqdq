\033[38;5;231m  !sysinfo    \x1b[38;5;160m:\033[38;5;231m show system info\033[38;5;231m.\r\r
\033[38;5;231m  !logs       \x1b[38;5;160m:\033[38;5;231m view system logs\033[38;5;231m.\r\r
\033[38;5;231m  !blacklist  \x1b[38;5;160m:\033[38;5;231m manage IP blacklist\033[38;5;231m.\r\r
